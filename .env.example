# Server-side only. Never prefix any of these with NEXT_PUBLIC_.

# OpenAI API key (platform.openai.com > API keys). Used for embeddings and chat.
OPENAI_API_KEY=

# Supabase project URL (Project Settings > API), e.g. https://abcdefghijkl.supabase.co
SUPABASE_URL=

# Supabase publishable key (Project Settings > API Keys, starts with sb_publishable_). Used by the app.
# Safe by design: both tables have RLS with no policies; with this key the app can only call match_places()
# (read-only) and create_concierge_request() (validated insert, returns an id).
SUPABASE_KEY=

# Supabase secret key (starts with sb_secret_). ONLY for scraper/load.py. Not needed by the app or Vercel.
SUPABASE_SECRET_KEY=

# Optional. Model for the planner and follow-up chips. Defaults to gpt-4.1-mini.
OPENAI_CHAT_MODEL=

# Optional. Model that writes the reply. Defaults to gpt-4.1.
OPENAI_ANSWER_MODEL=
